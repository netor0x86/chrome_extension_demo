{
    "manifest_version": 3,
    "name": "网页背景色修改器",
    "version": "1.0",
    "description": "点击按钮，修改当前网页的背景色。",
    "background": {
        "service_worker": "background/background.js"
    },
    "action": {
        "default_popup": "popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/content.js"]
        }
    ],
    "permissions": ["activeTab"]
}
